# FiveOps Dashboard - Vercel production settings
# Store secrets only in Vercel Environment Variables, never commit .env.local.
# NEVER open MariaDB 3309 or Elasticsearch 9200 to the public internet.

JWT_SECRET=generate_at_least_32_random_characters
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-vercel-site.vercel.app/api/auth/callback

# HTTPS address of an authenticated Cloudflare Tunnel to the VPS Node.js backend.
FIVEOPS_BACKEND_URL=https://logs-api.your-domain.example
# Must match the backend-only FIVEOPS_BRIDGE_KEY in C:/FiveOps/backend/.env.
FIVEOPS_BRIDGE_KEY=generate_independent_64_hex_character_secret

# Direct MYSQL_* settings are supported only for local non-Vercel development.
# For Vercel, backend connects to local MariaDB 127.0.0.1:3309 instead.
