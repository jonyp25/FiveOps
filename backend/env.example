# ===========================================
# FiveM Logs Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Server Port
PORT=3000

# Elasticsearch
ELASTICSEARCH_NODE=https://localhost:9200
ELASTICSEARCH_INDEX=fivem-logs

# Elasticsearch 9 enables HTTPS and authentication by default.
# Never commit the real .env or paste passwords into chat.
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace_with_local_password
# Path to the CA certificate created on first Elasticsearch startup
ELASTICSEARCH_CA_CERT_PATH=C:/Elasticsearch/elasticsearch-9.5.6/config/certs/http_ca.crt

# ===========================================
# Elasticsearch Setup:
# ===========================================
# 1. Download Elasticsearch 9.x from elastic.co
# 2. Run: bin/elasticsearch
# 3. Secure default: https://localhost:9200
# 4. Optional: Run Kibana for visualization
#    - Download Kibana 9.x
#    - Run: bin/kibana
#    - Access at http://localhost:5601
# ===========================================

